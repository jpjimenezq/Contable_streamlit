# Copia este archivo como `secrets.toml` y completa los valores.
# `secrets.toml` NO se sube a GitHub (está en .gitignore). Este ejemplo sí, y no lleva datos reales.

[cookie]
name = "portal_contable_auth"
key = "una-cadena-larga-y-aleatoria"   # cámbiala por una propia
expiry_days = 1                          # días que dura la sesión

[credentials.admin]
name = "Administrador"
email = "correo@ejemplo.com"
password = "$2b$12$...contraseña cifrada (ver README)..."

# Agente de Datos (Gemini, capa gratuita): https://aistudio.google.com/apikey
[gemini]
api_key = "PEGA_AQUI_TU_API_KEY_DE_GEMINI"
# model = "gemini-3.6-flash"   # opcional

# Solo para "Comparativa Contable 2" (lee PDF con OpenAI)
[settings]
key = "PEGA_AQUI_TU_API_KEY_DE_OPENAI"
